# Copie para .env na raiz do projeto e ajuste os valores.

# --- Banco (container db) ---
POSTGRES_USER=chamados
POSTGRES_PASSWORD=chamados
POSTGRES_DB=chamados_ti

# --- API ---
# Usada quando a API roda no host (npm run dev). No Docker, o Compose
# monta a URL apontando para o serviço db.
DATABASE_URL=postgresql://chamados:chamados@localhost:5432/chamados_ti
PORT=3333
CORS_ORIGIN=http://localhost:5173
# Segredo para assinar o JWT (mínimo 32 caracteres). Gere um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
